# ── Supabase (public keys, safe to expose) ────────────────────────────────────
# Optional for local dev: without these the site runs signed-out.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── API ───────────────────────────────────────────────────────────────────────
# Local dev: omit to use http://localhost:3001 (the API started by `npm run dev`).
# Production: URL of the deployed API service on Railway
# Get this from Railway dashboard → API service → Settings → Domains
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
