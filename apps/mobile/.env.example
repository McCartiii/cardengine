# ── Supabase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── API ───────────────────────────────────────────────────────────────────────
# Local dev: use your machine's LAN IP  e.g. http://192.168.1.10:3001
# (`npm run dev` at the repo root prints the exact URL). A phone can't reach
# "localhost" on your computer; the iOS simulator can.
# TestFlight / production: set in eas.json build profile env block instead
EXPO_PUBLIC_API_URL=http://YOUR-LAN-IP:3001
